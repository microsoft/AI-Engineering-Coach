# Source & build config
src/**
scripts/**
tests/**
docs/**
esbuild.mjs
tsconfig.json
vitest.config.mts
eslint.config.mjs

# Dev state
.vscode/**
.github/**
.git/**
.gitignore
.eslintignore

# Artifacts
**/*.test.ts
**/*.test.js
**/*.map
*.vsix
dist/**/*.map

# Docs scaffolding (only publish README + LICENSE + dist)
README.github.md
SECURITY.md

# Benchmark / perf outputs
benchmark-*.json

# Runtime deps are bundled into dist/ by esbuild — ship the bundle, not node_modules.
# Exception: better-sqlite3 is a native module that cannot be bundled by esbuild;
# include its prebuilt binary so the extension host can load it at runtime.
node_modules/**
!node_modules/better-sqlite3/**
!node_modules/bindings/**
!node_modules/file-uri-to-path/**

# Local manual-test rules (project-layer, for exercising the trust gate in dev)
.ai-engineer-coach/**
