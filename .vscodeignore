# Source & build config
src/**
scripts/**
tests/**
docs/**
esbuild.mjs
tsconfig.json
vitest.config.mts
eslint.config.mjs

# Dev state
.vscode/**
.github/**
.git/**
.gitignore
.eslintignore

# Artifacts
**/*.test.ts
**/*.test.js
**/*.map
*.vsix
dist/**/*.map

# Docs scaffolding (only publish README + LICENSE + dist)
README.github.md
SECURITY.md

# Benchmark / perf outputs
benchmark-*.json

# Runtime deps are bundled into dist/ by esbuild — ship the bundle, not node_modules.
# Exception: @vscode/sqlite3 is a native module compiled for VS Code's Electron;
# include it so the extension host and its child processes can require() it.
# better-sqlite3 is a devDependency (tests only) and must NOT be shipped.
node_modules/**
!node_modules/@vscode/sqlite3/**

# Local manual-test rules (project-layer, for exercising the trust gate in dev)
.ai-engineer-coach/**
