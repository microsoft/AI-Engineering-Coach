        "    number = float(value)",
        "    return round(number, 1)",
        "",
        "def summarize_readings(values):",
        "    readings = [normalize_reading(value) for value in values]",
        "    total = sum(readings)",
        "    return {\"count\": len(readings), \"total\": total}"
